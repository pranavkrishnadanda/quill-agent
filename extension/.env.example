# Base URL of the local verification server (see ../job-agent-server)
VITE_VERIFICATION_SERVER_URL=http://127.0.0.1:8787
# Bearer token (must match server's AUTH_TOKEN in ../job-agent-server/.env)
VITE_VERIFICATION_TOKEN=paste-64-hex-token-here
# Optional: default Anthropic API key (user pastes in Options UI usually)
VITE_ANTHROPIC_API_KEY=
